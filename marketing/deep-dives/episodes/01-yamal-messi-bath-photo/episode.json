    }
   ]
  },
  {
   "vo": "Summer, twenty twenty-four. The European Championship semi-final, against France. Yamal is sixteen. He cuts inside from the right and curls the ball into the top corner.",
   "shots": [
    {
     "clip": "stadium-drone-full",
     "tag": "EURO 2024"
    },
    {
     "clip": "ball-top-corner-pixar"
    },
    {
     "clip": "fans-spain-stand"
    }
   ]
  },
  {
   "vo": "The youngest scorer in the history of the Euros. Four days later, he turns seventeen. Five days later, Spain are champions of Europe.",
   "shots": [
    {
     "clip": "spain-flag",
     "over": {
      "type": "stat",
      "value": 16,
      "label": "YEARS OLD",
      "sub": "YOUNGEST EVER SCORER"
