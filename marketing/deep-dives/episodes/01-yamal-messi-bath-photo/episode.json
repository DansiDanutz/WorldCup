    }
   ]
  },
  {
   "vo": "Summer, two thousand and seven. Barcelona's club foundation, UNICEF and the newspaper Diario Sport are making a charity calendar. Families from the neighbourhoods around Barcelona will be photographed at the Camp Nou, with a first-team player.",
   "shots": [
    {
     "clip": "floodlight-towers",
     "over": {
      "type": "date",
