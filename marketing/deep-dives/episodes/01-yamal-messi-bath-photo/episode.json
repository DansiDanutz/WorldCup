    },
    {
     "clip": "stadium-empty-wide"
    }
   ]
  },
  {
   "vo": "Up the coast in Mataró, in a working-class district called Rocafonda, families sign up for a raffle. One young couple wins it.",
   "shots": [
    {
     "scene": {
      "type": "route",
      "a": {
