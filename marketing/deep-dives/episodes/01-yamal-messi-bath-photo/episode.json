  {
   "vo": "The photographer, Joan Monfort, fills a small plastic tub with water. Messi is asked to bathe the baby for the camera. He is nervous. Careful. Gentle. Click.",
   "shots": [
    {
     "scene": {
      "type": "artifact",
      "kind": "polaroid",
      "date": "2007",
      "title": "CAMP NOU",
      "art": "bath"
     }
    }
   ]
  },
  {
   "vo": "The calendar is printed. It raises its money. And then the photos simply vanish. For seventeen years, almost nobody sees them.",
   "shots": [
    {
     "scene": {
      "type": "impact",
      "text": "VANISHED"
     },
     "w": 0.8
    },
    {
     "clip": "night-sky-roof",
     "over": {
